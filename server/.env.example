# --- Anthropic ---
# Get a key at https://platform.claude.com — leave empty to run in mock/demo mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- The client (real estate agent) this deployment serves ---
AGENT_NAME=Sarah Bennett
AGENT_BROKERAGE=Harborline Realty
AGENT_MARKET=Tampa Bay, Florida
AGENT_PHONE=(813) 555-0142
AGENT_EMAIL=sarah@harborlinerealty.com
# Optional Calendly/booking link offered to hot leads
AGENT_CALENDAR_URL=

# --- Operations ---
PORT=3000
# Protects /api/leads and the dashboard. CHANGE THIS.
DASHBOARD_TOKEN=changeme
# Optional: Zapier/Make webhook that receives every captured lead as JSON
NOTIFY_WEBHOOK=

# --- Cost guardrails ---
MAX_TURNS=30
RATE_LIMIT_PER_HOUR=60
