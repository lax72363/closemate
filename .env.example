# --- Server ---
PORT=3000
# Public base URL of this deployment (used in Twilio webhook config + Stripe redirects)
BASE_URL=https://your-app.up.railway.app
# Path to the SQLite database file
DB_PATH=./data/closemate.db

# --- Anthropic (AI conversations) ---
ANTHROPIC_API_KEY=sk-ant-...
# Default model. Set MODEL=claude-haiku-4-5 to cut AI cost ~5x if margins ever matter more than reply quality.
MODEL=claude-opus-4-8

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price for the Solo plan (create in Stripe dashboard)
STRIPE_PRICE_ID=price_...
